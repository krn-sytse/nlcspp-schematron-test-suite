{
  "name": "schematron-test-suite",
  "displayName": "NLCS++ Schematron Test Suite",
  "description": "Testing tools for local development of NLCS++ validation rules.",
  "publisher": "SytseWalraven",
  "version": "0.0.2",
  "icon": "./icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/krn-sytse/nlcspp-schematron-test-suite"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Schematron Validator",
      "properties": {
        "schematron.jarPath": {
          "type": "string",
          "default": "/schxslt-cli.jar",
          "description": "Relative path to the Schematron validator JAR file"
        },
        "schematron.maxConcurrentValidations": {
          "type": "integer",
          "default": 4,
          "minimum": 1,
          "description": "Maximum number of Schematron validator (java) processes to run concurrently during a test run"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "build": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.0",
    "eslint": "^9.25.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5"
  }
}
